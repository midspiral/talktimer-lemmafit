{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "lemmafit-verify-hook"
          },
          {
            "type": "command",
            "command": "lemmafit-spec-hook"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lemmafit-context-hook"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "lemmafit-session-hook"
          }
        ]
      }
    ]
  }
}
